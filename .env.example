# Copy to .env and fill in. .env is gitignored; this file is the checked-in
# contract for what a working environment needs.

# Neon serverless Postgres. Use the POOLED endpoint (hostname contains
# "-pooler"): the HTTP driver opens a fresh connection per request, and an
# unpooled endpoint will exhaust its connection limit under any real traffic.
# sslmode=require is not optional -- Neon rejects plaintext.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/islatap?sslmode=require

# Shared secret for the scheduled top-up job. Vercel injects this as
# `Authorization: Bearer $CRON_SECRET` on cron invocations once it is set as a
# project environment variable. /api/cron/top-up stays publicly routable, so
# this is the only thing protecting the single write path in production.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-me-with-64-hex-characters
