# Vercel turns every file under api/ into a deployed function. Without this,
# api/daily.test.ts becomes a route that imports `vitest` -- a devDependency
# that is not installed in the production bundle -- and the deploy fails.
**/*.test.ts
**/*.test.mjs

# Seed source + tooling: needed to build the database, never at request time.
migrations/
scripts/
docs/
